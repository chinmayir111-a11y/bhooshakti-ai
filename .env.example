# ============================================================================
# BHOOSHAKTI AI — environment template
# Copy to .env and edit.  ALL DATA IN THIS SYSTEM IS SIMULATED / DEMO DATA.
# ============================================================================

# ---------------------------------------------------------------- database --
# Native (Homebrew) local run — default
DATABASE_URL=postgresql+psycopg2://bhooshakti:bhooshakti@localhost:5432/bhooshakti
# docker compose run — use this instead
# DATABASE_URL=postgresql+psycopg2://bhooshakti:bhooshakti@db:5432/bhooshakti

# ------------------------------------------------------------------- auth ---
# Change this in any non-demo deployment.
JWT_SECRET=change-me-bhooshakti-demo-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
DEMO_PASSWORD=demo1234

# ------------------------------------------------------------------- mqtt ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=bhooshakti/sensors
MQTT_ENABLED=true

# ------------------------------------------------------------------- api ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# --------------------------------------------------------------- notify -----
# Comma-separated dispatch channels. Order does not matter.
# Options: console, websocket, email, sms, push
NOTIFY_CHANNELS=console,websocket,email,sms,push

# Where the "Send test alert" button and scripts/test_alert_email.py send to.
ALERT_TEST_EMAIL=abjgd108@gmail.com

# Deep link embedded in alert emails (points at the dashboard zone drawer).
PUBLIC_DASHBOARD_URL=http://localhost:5173

# --- Email (REAL send). Leave SMTP_HOST blank to keep email in stub mode. ---
# Gmail:  smtp.gmail.com / 587 / your address / a 16-char App Password
#         (App Passwords require 2FA: https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BHOOSHAKTI AI <no-reply@bhooshakti.local>
SMTP_STARTTLS=true

# --- SMS. Defaults to SIMULATED stub; no paid account needed to demo. -------
# Set SMS_PROVIDER=twilio or msg91 only if you have credentials.
SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
ALERT_TEST_PHONE=+910000000000

# --- Push (Expo). Defaults to stub when no device token is registered. ------
PUSH_PROVIDER=stub
EXPO_ACCESS_TOKEN=

# ------------------------------------------------------------- weather ------
# Real observed weather from Open-Meteo (free, no API key, non-commercial use).
#   open-meteo  → fetch real precipitation + soil moisture per zone, cache in DB
#   simulated   → fall back to the synthetic generator in scripts/seed.py
WEATHER_PROVIDER=open-meteo
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_HISTORY_DAYS=30
WEATHER_FORECAST_DAYS=5
WEATHER_ARCHIVE_LAG_DAYS=3
WEATHER_TIMEOUT_S=90
WEATHER_BATCH_SIZE=25

# ---------------------------------------------------------------- ml --------
MODEL_PATH=ml/artifacts/susceptibility_xgb.joblib
MODEL_META_PATH=ml/artifacts/model_meta.json

# ---------------------------------------------------------------- demo ------
# Seconds of wall-clock for the scripted monsoon timeline at 1x speed.
DEMO_TIMELINE_SECONDS=60
SEED_RANDOM_STATE=26001

# ---------------------------------------------------------------- web -------
# Consumed by web/ at build time (Vite requires the VITE_ prefix).
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
# Leave blank to use Leaflet + OpenStreetMap (no token required).
# Set a token to switch the map layer to Mapbox GL JS.
VITE_MAPBOX_TOKEN=
